# -------------------------------------------------------------
# Shasthi Guru Dream Campus - Environment Configuration (.env.example)
# Safe placeholder template - DO NOT commit real secrets to Git
# -------------------------------------------------------------

# Application
NODE_ENV="development"
PORT=5001
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/shasthi_guru_db?schema=public"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="your-super-secret-cookie-key-min-32-chars"

# Aadhaar Security (AES-256-GCM)
# Note: Keep disabled until client provides explicit written compliance confirmation
ENABLE_AADHAAR_COLLECTION=false
AADHAAR_ENCRYPTION_KEY="32-byte-hex-encryption-key-for-aes-256"

# Donation Module Feature Flags
# Note: Keep disabled until payment gateway and trust/entity details are confirmed
ENABLE_DONATION_MODULE=false
ENABLE_PAYMENT_GATEWAY=false
PAYMENT_GATEWAY_PROVIDER="none"
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""

# Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
NOTIFICATION_RECEIVER_EMAIL="admin@shasthiguru.com"

# Initial Admin Seeding Credentials (For Development / Staging only)
INITIAL_ADMIN_EMAIL="admin@shasthiguru.com"
INITIAL_ADMIN_PASSWORD="ShasthiAdmin2026!"
INITIAL_ADMIN_NAME="System Administrator"
